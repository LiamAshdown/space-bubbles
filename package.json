{
  "name": "space-bubbles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "assetpack",
    "watch:assetpack": "assetpack -w",
    "watch": "npm run watch:assetpack & npm run dev",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  },
  "dependencies": {
    "@assetpack/core": "^1.6.1",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.2.7",
    "@types/matter-js": "^0.20.2",
    "gsap": "^3.13.0",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.13.2"
  }
}
